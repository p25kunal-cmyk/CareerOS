#!/bin/bash

PROJECT_DIR="/Users/kunaljakhotiya/Desktop/CarrerOS"
cd "$PROJECT_DIR" || exit 1

# If already running, open browser immediately and exit
if pgrep -f "streamlit run src/app.py" > /dev/null; then
    open "http://localhost:8501"
    exit 0
fi

# Start Streamlit
"./venv/bin/streamlit" run src/app.py --server.headless=true --server.port=8501 > "$PROJECT_DIR/logs/streamlit.log" 2>&1 &

# Wait for server to become responsive, then open browser
for i in {1..30}; do
    if curl -s "http://localhost:8501" > /dev/null; then
        break
    fi
    sleep 0.5
done

open "http://localhost:8501"
