# ============================================================
# CareerOS Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Data directory (default: ./data)
# CAREEROS_DATA_DIR=./data

# Database path (default: ./data/careeros.db)
# CAREEROS_DB_PATH=./data/careeros.db

# Logging
CAREEROS_LOG_LEVEL=INFO
# CAREEROS_LOG_FILE=./logs/careeros.log

# AI Provider (optional)
# Supported providers: openai, google
# CAREEROS_AI_PROVIDER=openai
# CAREEROS_AI_API_KEY=your-api-key-here
# CAREEROS_AI_MODEL=gpt-4o-mini
# CAREEROS_AI_MAX_TOKENS=4096
# CAREEROS_AI_MONTHLY_BUDGET=10.00

# Local API for Chrome Extension (optional)
# CAREEROS_API_HOST=127.0.0.1
# CAREEROS_API_PORT=8400
# CAREEROS_API_SECRET=generate-a-random-secret-here

# OCR — path to Tesseract binary (optional, for scanned PDFs)
# TESSERACT_CMD=/usr/local/bin/tesseract
